datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum FileCategory {
  documents
  images
  videos
  others
}

enum VersionStatus {
  PROCESSING
  READY
  FAILED
}

enum InternalPermission {
  VIEWER
  DOWNLOADER
  EDITOR
  MANAGER
}

enum ShareStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditStatus {
  SUCCESS
  FAILED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model User {
  id                      String             @id @default(uuid())
  name                    String
  email                   String             @unique
  password                String
  role                    Role               @default(USER)
  lastLoginAt             DateTime           @default(now())
  devices                 Json?              @default("[]")
  notificationPreferences Json?              @default("{}")
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  files                   File[]
  externalShares          Share[]
  sentShares              InternalShare[]    @relation("SentShares")
  receivedShares          InternalShare[]    @relation("ReceivedShares")
  accessRequestsSent      AccessRequest[]    @relation("AccessRequestsSent")
  accessRequestsReceived  AccessRequest[]    @relation("AccessRequestsReceived")
  auditLogs               Audit[]
  webhooks                Webhook[]
  notifications           Notification[]
  consentRecords          ConsentRecord[]
  dlpAlerts               DlpAlert[]
}

model File {
  id             String          @id @default(uuid())
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  originalName   String
  extension      String
  currentVersion Int             @default(1)
  isFavorite     Boolean         @default(false)
  isTrashed      Boolean         @default(false)
  trashedAt      DateTime?
  category       FileCategory    @default(others)
  hasSensitiveData Boolean       @default(false)
  isRedacted       Boolean       @default(false)
  sensitiveTypes   String[]      @default([])
  maskedAadhaar    String?
  redactionDetails Json?         @default("{}")
  dpdpRetentionDays Int?         @default(365)
  dpdpExpiresAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  versions       FileVersion[]
  externalShares Share[]
  internalShares InternalShare[]
  accessRequests AccessRequest[]
  consentRecords ConsentRecord[]
  dlpAlerts      DlpAlert[]
}

model FileVersion {
  id              String        @id @default(uuid())
  fileId          String
  file            File          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  version         Int
  storedName      String
  s3Key           String
  size            Int
  mimeType        String
  iv              String?
  hash            String?
  status          VersionStatus @default(PROCESSING)
  isZeroKnowledge Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([fileId, version])
}

model Share {
  id                String   @id @default(uuid())
  fileId            String
  file              File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  token             String   @unique
  expiresAt         DateTime
  password          String?
  maxDownloads      Int      @default(1)
  downloadCount     Int      @default(0)
  allowedIP         String?
  isPasswordEnabled Boolean  @default(false)
  isOtpEnabled      Boolean  @default(false)
  otpEmail          String?
  isOneTimeAccess   Boolean  @default(false)
  isActive          Boolean  @default(true)
  autoMask          Boolean  @default(true)
  version           Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model InternalShare {
  id             String             @id @default(uuid())
  ownerId        String
  owner          User               @relation("SentShares", fields: [ownerId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      User               @relation("ReceivedShares", fields: [recipientId], references: [id], onDelete: Cascade)
  fileId         String
  file           File               @relation(fields: [fileId], references: [id], onDelete: Cascade)
  permission     InternalPermission @default(DOWNLOADER)
  status         ShareStatus        @default(PENDING)
  message        String             @default("")
  expiresAt      DateTime?
  maxDownloads   Int?
  downloadsCount Int                @default(0)
  autoMask       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model AccessRequest {
  id          String        @id @default(uuid())
  fileId      String
  file        File          @relation(fields: [fileId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User          @relation("AccessRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User          @relation("AccessRequestsReceived", fields: [ownerId], references: [id], onDelete: Cascade)
  note        String        @default("")
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Audit {
  id           String      @id @default(uuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  status       AuditStatus
  ip           String
  userAgent    String?
  details      Json?
  previousHash String?
  recordHash   String?
  signature    String?
  createdAt    DateTime    @default(now())
}

model Webhook {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  url       String
  events    String[] @default(["FILE_SHARED"])
  isActive  Boolean  @default(true)
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String               @default("FILE_SHARED")
  priority  NotificationPriority @default(NORMAL)
  isRead    Boolean              @default(false)
  actionUrl String               @default("")
  metadata  Json?                @default("{}")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

enum ConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
}

enum DlpSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DlpChannel {
  PUBLIC_LINK
  INTERNAL_SHARE
  QR_SCAN
  DIRECT_DOWNLOAD
  BULK_EXPORT
}

enum DlpStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  BLOCKED
}

model ConsentRecord {
  id               String             @id @default(uuid())
  fileId           String
  file             File               @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataSubjectName  String
  dataSubjectEmail String?
  dataSubjectPhone String?
  purpose          String             // e.g. "Identity Verification", "KYC / Admissions", "Medical Billing"
  lawfulBasis      String             @default("EXPLICIT_CONSENT")
  status           ConsentStatus      @default(GRANTED)
  grantedAt        DateTime           @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  retentionNotice  String?
  accessLogs       ConsentAccessLog[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model ConsentAccessLog {
  id               String        @id @default(uuid())
  consentId        String
  consent          ConsentRecord @relation(fields: [consentId], references: [id], onDelete: Cascade)
  accessedByUserId String?
  accessedByName   String        @default("Authorized Staff")
  action           String        // "VIEW", "DOWNLOAD", "SHARE", "REDACT", "DELETE"
  purpose          String
  ipAddress        String
  userAgent        String?
  timestamp        DateTime      @default(now())
}

model DlpAlert {
  id             String      @id @default(uuid())
  fileId         String?
  file           File?       @relation(fields: [fileId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel        DlpChannel
  severity       DlpSeverity
  ruleTriggered  String      // "PII_PUBLIC_LEAK", "MASS_DOWNLOAD_ANOMALY", "OFF_HOURS_ACCESS", "ANONYMOUS_UNENCRYPTED_SHARE"
  description    String
  riskScore      Int         // 0 to 100
  ipAddress      String
  userAgent      String?
  metadata       Json?       @default("{}")
  status         DlpStatus   @default(OPEN)
  mitigationNote String?
  resolvedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

