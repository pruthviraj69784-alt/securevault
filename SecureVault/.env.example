PORT=5000
NODE_ENV=production

# PostgreSQL connection string (Provided automatically by Railway PostgreSQL plugin)
DATABASE_URL="postgresql://user:password@host:port/database"

# 64-character random hex string for JWT signing
JWT_SECRET=your_64_character_random_hex_secret_here
JWT_EXPIRES_IN=7d

# Exactly 32 characters (32 bytes for AES-256-GCM)
ENCRYPTION_KEY=your_exact_32_character_key_here

# Frontend URL(s) for CORS (comma-separated if multiple, e.g. https://your-app.up.railway.app)
CORS_ORIGIN=https://your-frontend.up.railway.app

# AWS S3 Storage
AWS_REGION=ap-southeast-2
AWS_BUCKET_NAME=securevault-storage
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Redis (Provided automatically by Railway Redis plugin via REDIS_URL)
REDIS_URL=redis://default:password@host:port

# Optional Mail (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_user
MAIL_PASSWORD=your_password
MAIL_FROM="SecureVault <noreply@securevault.dev>"
